# Tenderly Configuration
# IMPORTANTE: TENDERLY_PROJECT deve ser o SLUG do projeto (da URL), não o nome!
# Veja: https://docs.tenderly.co/tenderly-sdk/intro-to-tenderly-sdk#how-to-get-the-account-name-project-slug-and-secret-key
# 
# Para encontrar o slug correto:
# 1. Acesse seu projeto no dashboard Tenderly
# 2. Olhe a URL: https://dashboard.tenderly.co/[ACCOUNT]/[PROJECT_SLUG]/
# 3. Use exatamente o que aparece na URL (exemplo: se a URL tem /project/project/, então TENDERLY_PROJECT=project)
TENDERLY_ACCOUNT=Omnes
TENDERLY_PROJECT=project  # ⚠️ Use o slug exato da URL do dashboard (não o nome do projeto!)
TENDERLY_KEY=SEU_TOKEN_AQUI  # Gere em: Account Settings > Access Tokens
TENDERLY_NODE_ACCESS_KEY=https://mainnet.gateway.tenderly.co/5VDSGAmca9mO7UCbiRBGc0

# EOA for simulations (pode ser vazio em bundle)
FROM=0xSEU_ENDERECO_EOA

# VirtualNet RPC (substitua com sua VirtualNet URL)
# Opcional: Necessário apenas para scripts que usam VirtualNet (vnet:swapv3)
VNET_RPC=https://virtual.mainnet.eu.rpc.tenderly.co/54e15302-bb51-4ea2-b124-540392e84dad

# Private Key para VirtualNet (APENAS para VirtualNet - NUNCA use chave com fundos na mainnet!)
# ⚠️ ATENÇÃO: Use uma chave privada de TESTE que NÃO tenha fundos na mainnet real
# Como gerar uma chave de teste:
# 1. Use MetaMask ou outra carteira para gerar uma nova conta de teste
# 2. Exporte a private key (Settings > Security & Privacy > Show Private Key)
# 3. VERIFIQUE que esta chave NÃO tem fundos na mainnet real antes de usar!
# Formato: 0x seguido de 64 caracteres hexadecimais
# Exemplo: 0x5c...
TENDERLY_PRIVATE_KEY=0xSEU_PRIVATE_KEY_AQUI

# Debug mode (mostra detalhes completos dos erros e payloads)
DEBUG=false
